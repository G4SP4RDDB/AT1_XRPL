# Track 1 — Custom Hackathon Devnet (see CLAUDE.md §2). Copy to .env, never commit .env.
VITE_XRPL_WSS=wss://lending-hackathon.dev.ripplex.io:51233
VITE_XRPL_RPC=https://lending-hackathon.dev.ripplex.io:51234
VITE_XRPL_FAUCET=https://lending-hackathon-faucet.dev.ripplex.io/accounts
